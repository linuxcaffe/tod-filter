# tw-tod - Time of Day context filter for Taskwarrior 2.6.2
# Include this file from .taskrc:  include ~/.task/config/tod.rc
# version 0.1.2
#
# Block definitions - customize times and days to suit your schedule
# Time blocks use HH:MM-HH:MM format (24hr), overnight ranges supported
# Day blocks use comma-separated day abbreviations: mon,tue,wed,thu,fri,sat,sun
#
# Tag your tasks with +morn, +aft, +eve, +nite, +day, +wkday, +wkend
# Then: task context tod

# --- Time blocks (edit these!) ---
tod.block.morn=08:00-12:00
tod.block.aft=12:00-18:00
tod.block.eve=18:00-22:00
tod.block.nite=22:00-07:00
tod.block.day=08:00-18:00

# --- Day blocks ---
tod.block.wkday=mon,tue,wed,thu,fri
tod.block.wkend=sat,sun

# --- Generated by on-launch-tod.py (do not edit below this line) ---
context.tod.read=
